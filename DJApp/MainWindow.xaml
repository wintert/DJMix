<Window x:Class="DJAutoMixApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DJ Auto-Mix Pro" Height="800" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DarkBackgroundBrush}">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource MediumBackgroundBrush}" 
                CornerRadius="8" Padding="20,15" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🎵 DJ AUTO-MIX PRO" Style="{StaticResource HeaderText}"/>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SubHeaderText}" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTrackName}" Style="{StaticResource BodyText}" 
                               FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource PurpleAccentBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Now Playing -->
                <RowDefinition Height="20"/>   <!-- Spacer -->
                <RowDefinition Height="*"/>    <!-- Expanded Playlist -->
            </Grid.RowDefinitions>

            <!-- NOW PLAYING SECTION (Top) -->
            <Border Grid.Row="0" Background="{StaticResource MediumBackgroundBrush}" 
                    CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Track Info & Controls -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title -->
                        <TextBlock Grid.Row="0" Text="NOW PLAYING" Style="{StaticResource SubHeaderText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <TextBlock Grid.Row="1" Text="{Binding ActiveDeckViewModel.TrackName}" Style="{StaticResource HeaderText}" FontSize="24" TextTrimming="CharacterEllipsis"/>
                        
                        <!-- Progress & Waveform -->
                        <Grid Grid.Row="2" Margin="0,15,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Waveform -->
                            <Border Grid.Row="0" Height="80" Background="#111" CornerRadius="4" ClipToBounds="True" BorderBrush="#333" BorderThickness="1" Padding="2,5" Margin="0,0,0,10">
                                <Grid>
                                    <Viewbox Stretch="Fill">
                                        <Grid>
                                            <Polyline Points="{Binding ActiveDeckViewModel.WaveformPoints}" Stroke="#555" StrokeThickness="1" Fill="#333" Opacity="0.5"/>
                                            <Polyline Points="{Binding ActiveDeckViewModel.WaveformPoints}" Stroke="{StaticResource PurpleAccentBrush}" StrokeThickness="1" Fill="{StaticResource PurpleAccentBrush}">
                                                <Polyline.OpacityMask>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Offset="{Binding ActiveDeckViewModel.Progress}" Color="Black"/>
                                                        <GradientStop Offset="{Binding ActiveDeckViewModel.Progress}" Color="Transparent"/>
                                                    </LinearGradientBrush>
                                                </Polyline.OpacityMask>
                                            </Polyline>
                                            <Path Data="{Binding ActiveDeckViewModel.BeatGridGeometry}" Stroke="White" StrokeThickness="5" Opacity="0.6"/>
                                        </Grid>
                                    </Viewbox>
                                </Grid>
                            </Border>

                            <!-- Progress Bar & Time -->
                            <StackPanel Grid.Row="1">
                                <ProgressBar Value="{Binding ActiveDeckViewModel.ProgressPercentage, Mode=OneWay}" 
                                             Style="{StaticResource ModernProgressBar}" Height="6"/>
                                <Grid Margin="0,5,0,0">
                                    <TextBlock Text="{Binding ActiveDeckViewModel.FormattedPosition}" Style="{StaticResource BodyText}" HorizontalAlignment="Left" Foreground="#DDD"/>
                                    <TextBlock Text="{Binding ActiveDeckViewModel.FormattedTimeRemaining}" Style="{StaticResource BodyText}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Play Controls -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Command="{Binding ActiveDeckViewModel.PlayPauseCommand}" 
                                    Style="{StaticResource ModernButton}"
                                    Width="120" Height="45" FontSize="16" Margin="0,0,15,0">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="▶ PLAY"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveDeckViewModel.IsPlaying}" Value="True">
                                                    <Setter Property="Text" Value="⏸ PAUSE"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <!-- BPM Display -->
                            <Border Background="#222" CornerRadius="4" Padding="15,0" Height="45" BorderBrush="#333" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveDeckViewModel.EffectiveBPM, StringFormat='{}{0:F1}'}" FontWeight="Bold" FontSize="20" Foreground="{StaticResource PurpleAccentBrush}" VerticalAlignment="Bottom"/>
                                    <TextBlock Text=" BPM" FontSize="10" Foreground="#888" VerticalAlignment="Bottom" Margin="3,0,0,4"/>
                                </StackPanel>
                            </Border>

                            <!-- Volume Slider -->
                            <StackPanel VerticalAlignment="Center" Margin="20,0,0,0" Width="150">
                                <TextBlock Text="VOLUME" FontSize="10" Foreground="#888" TextAlignment="Center" Margin="0,0,0,2"/>
                                <Slider Value="{Binding ActiveDeckViewModel.Volume}" Minimum="0" Maximum="100" Style="{StaticResource ModernSlider}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Drag & Drop Zone Hint -->
                    <Border Grid.Column="2" BorderBrush="#333" BorderThickness="2" CornerRadius="8" Width="150" Background="#1A1A1A"
                             AllowDrop="True"
                             DragOver="DeckA_DragOver"
                             Drop="DeckA_Drop">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                             <TextBlock Text="📥" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                             <TextBlock Text="Drop Track Here" FontSize="12" Foreground="#888" TextAlignment="Center"/>
                             <TextBlock Text="(Deck A/B)" FontSize="10" Foreground="#555" TextAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- PLAYLIST SECTION (Center - Expanded) -->
            <Border Grid.Row="2" Background="{StaticResource MediumBackgroundBrush}" 
                    CornerRadius="8" Padding="15"
                    AllowDrop="True" 
                    Drop="Playlist_Drop"
                    DragOver="Playlist_DragOver">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="PLAYLIST" Style="{StaticResource HeaderText}" VerticalAlignment="Bottom"/>
                        <TextBlock Text="(Drag files to add)" Style="{StaticResource BodyText}" 
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    </Grid>

                    <!-- Playlist Controls -->
                    <WrapPanel Grid.Row="1" Margin="0,0,0,15">
                        <Button Command="{Binding Playlist.AddTracksCommand}" Style="{StaticResource ModernButton}" Content="➕ Add Tracks" Margin="0,0,5,0" Padding="15,8"/>
                        <Button Command="{Binding Playlist.RemoveTrackCommand}" Style="{StaticResource ModernButton}" Content="➖ Remove" Margin="0,0,5,0" Padding="15,8"/>
                        <Button Command="{Binding Playlist.ReAnalyzeBPMCommand}" Style="{StaticResource ModernButton}" Content="🔄 Re-Analyze" Margin="0,0,5,0" Padding="15,8"/>
                        <Button Command="{Binding Playlist.ClearPlaylistCommand}" Style="{StaticResource ModernButton}" Content="🗑️ Clear All" Margin="0,0,5,0" Padding="15,8"/>
                    </WrapPanel>

                    <!-- Large Playlist Items -->
                    <ListBox Grid.Row="2" 
                             ItemsSource="{Binding Playlist.Tracks}"
                             SelectedItem="{Binding Playlist.SelectedTrack}"
                             Style="{StaticResource ModernListBox}"
                             ItemContainerStyle="{StaticResource PlaylistItemStyle}"
                             FontSize="14"
                             AllowDrop="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Play Icon -->
                                    <TextBlock Text="🎵" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0" Opacity="0.5"/>
                                    
                                    <!-- Title & Artist -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" Foreground="#EEE"/>
                                        <!-- Placeholder Artist if we had it, for now just path or duration hint -->
                                    </StackPanel>

                                    <!-- Duration -->
                                    <TextBlock Grid.Column="2" Text="{Binding Duration, StringFormat='{}{0:mm\\:ss}'}" 
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                    
                                    <!-- BPM Badge -->
                                    <Border Grid.Column="3" Background="#222" CornerRadius="4" Padding="8,4" BorderBrush="#333" BorderThickness="1">
                                        <TextBlock Text="{Binding BPM, StringFormat='{}{0:F0} BPM'}" FontWeight="Bold" Foreground="{StaticResource PurpleAccentBrush}" FontSize="12"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Auto-Mix and Stop Buttons -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="0" Command="{Binding ToggleAutoMixCommand}"
                    Height="60" Margin="0,0,10,0"
                    FontSize="18" FontWeight="Bold">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                        <Setter Property="Content" Value="🎵 START AUTO-MIX"/>
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{StaticResource PurpleAccent}" Offset="0"/>
                                    <GradientStop Color="{StaticResource BlueAccent}" Offset="1"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAutoMixEnabled}" Value="True">
                                <Setter Property="Content" Value="⏹️ STOP AUTO-MIX"/>
                                <Setter Property="Background" Value="#EF4444"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            
            <Button Grid.Column="1" Command="{Binding StopAllCommand}"
                    Height="60" Width="120"
                    FontSize="14" FontWeight="Bold"
                    Content="⏹ STOP ALL"
                    ToolTip="Stop all playback and reset">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                        <Setter Property="Background" Value="#6B7280"/>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="4" Background="{StaticResource LightBackgroundBrush}" 
                CornerRadius="6" Padding="15,10" Margin="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" TextAlignment="Center" FontSize="12"/>

                <!-- Tempo Recovery Progress -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsTempoRecoveryActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Tempo Recovery:" Style="{StaticResource BodyText}" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ProgressBar Value="{Binding TempoRecoveryProgress}" Width="100" Height="10" Style="{StaticResource ModernProgressBar}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
